
generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Roles {
  admin
  user
}

model User {
  user_id  Int    @id @default(autoincrement())
  email    String @unique
  name     String
  password String
  role     Roles  @default(user)
}
